# ---------------------------------------------------------------------------
# csmju-maintenance-request (ระบบแจ้งซ่อม) - ตัวอย่าง environment
# คัดลอกเป็น .env "ก่อน" รัน pnpm install  (ห้าม commit .env)
#   cp .env.example .env
# backend อ่าน backend/.env ก่อน แล้วจึงอ่าน .env ที่รากนี้
# ค่าทั้งหมดตาม standards/docs/connect-core-hub.md ข้อ 4 (Core Hub ตัวจริง)
# ---------------------------------------------------------------------------

NODE_ENV=development
# พอร์ต backend ของทีม (42xx) — frontend (32xx) เป็นประตูเดียวที่ผู้ใช้เปิด
PORT=4221

# ฐานข้อมูลของ subsystem นี้เท่านั้น - ห้ามชี้ไปที่ core_hub
# PostgreSQL ที่ติดตั้งในเครื่อง (พอร์ต 5432): สร้าง role + repair_db เอง (README) แล้วใช้
#   DATABASE_URL=postgresql://repair:<รหัสที่ตั้งเอง>@localhost:5432/repair_db
# หรือใช้ Docker: docker compose up -d db จะสร้าง repair_db ที่พอร์ต 5434 ให้
# Windows ขึ้น "ports are not available ... 5434": เครื่องจองช่วงพอร์ตนี้ไว้ (netsh interface ipv4 show excludedportrange protocol=tcp)
#   ตั้ง REPAIR_DB_PORT=15434 แล้วเปลี่ยนพอร์ตใน DATABASE_URL ให้ตรงกัน
# REPAIR_DB_PORT=5434
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/repair_db

# Core Hub (ผู้ให้ identity และข้อมูลกลาง) — API ใต้ /api/v1 · เว็บที่ /
CORE_HUB_URL=https://csmju2030.jowave.com
CORE_HUB_JWKS_URL=https://csmju2030.jowave.com/api/v1/.well-known/jwks.json
# เว็บที่ /auth/login ส่งเบราว์เซอร์ไป (/sso/authorize · /logout)
CORE_HUB_WEB_URL=https://csmju2030.jowave.com

# สัญญาที่ตรึงไว้ - ห้ามเปลี่ยนค่าเหล่านี้เอง
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# ตัวตนของ subsystem - ต้องตรงกับชื่อในทะเบียนของ Core Hub (และ azp ใน token)
SUBSYSTEM_ID=csmju-maintenance-request

# JWKS cache
JWKS_CACHE_TTL_MS=600000
JWKS_MIN_REFRESH_INTERVAL_MS=30000
JWKS_REQUEST_TIMEOUT_MS=5000
JWT_CLOCK_TOLERANCE_SEC=5

# ข้อมูลกลาง (อาคาร) จาก Core Hub — reference-data.md ข้อ 7.3
CORE_HUB_DATA_CACHE_TTL_MS=600000
CORE_HUB_DATA_MIN_REFRESH_INTERVAL_MS=30000
CORE_HUB_DATA_REQUEST_TIMEOUT_MS=5000

# ที่เก็บรูปถ่ายงานซ่อม (relative = นับจากโฟลเดอร์ backend/)
UPLOAD_DIR=uploads

# อีเมลบัญชี Core Hub (core role staff/lecturer) ที่เป็นผู้ดูแลระบบแจ้งซ่อม คั่นด้วย , (ทางชั่วคราว — REPORT ข้อ 8)
ADMIN_ACCOUNTS=

# ---- frontend (Next.js · http://localhost:3221) ----
# backend ที่ frontend ส่งต่อ /api/* และ /auth/login · /auth/callback · /auth/logout ไปให้ (rewrites ฝั่ง server)
BACKEND_URL=http://127.0.0.1:4221
# ปุ่ม "กลับหน้าหลัก" พาไป portal ของ Core Hub
NEXT_PUBLIC_CORE_HUB_URL=https://csmju2030.jowave.com
NEXT_PUBLIC_SUBSYSTEM_ID=csmju-maintenance-request
# (ไม่บังคับ) โดเมนจริงที่ใส่ใน QR ของสติกเกอร์/ใบงาน เมื่อพิมพ์จากเครื่องที่ไม่ได้เปิดผ่านโดเมนจริง
# NEXT_PUBLIC_APP_URL=
