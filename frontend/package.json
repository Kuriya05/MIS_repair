{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "description": "csmju-maintenance-request frontend (Next.js App Router)",
  "scripts": {
    "dev": "next dev -p 3221",
    "build": "next build",
    "start": "next start -p 3221",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,tsx,css}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "generate:api-types": "openapi-typescript ../backend/openapi.json -o src/lib/api-schema.ts && prettier --write src/lib/api-schema.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.1"
  }
}
